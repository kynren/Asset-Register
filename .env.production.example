# Copy this file to .env on the VPS and fill in real values. Never commit the real .env.
# Generate strong secrets with: openssl rand -hex 32

# --- Domain ---
# The domain pointed at this server (DNS A record must already resolve here for Caddy to
# get a Let's Encrypt certificate automatically). Use "localhost" only for a first smoke test
# before DNS is set up — Caddy will serve plain HTTP in that case, no TLS.
SITE_DOMAIN=your-domain.com
CLIENT_ORIGIN=https://your-domain.com

# --- Timezone ---
# Defaults to Europe/London if unset. Set this to the IANA zone Lighting Automations should
# schedule against — automation times are timezone-naive wall-clock values, so this must match
# the zone your users think in, not the VPS host's zone. Europe/London correctly handles the
# GMT/BST switch automatically; don't use a fixed offset like "GMT" or "GMT+1".
TZ=Europe/London

# --- Database ---
POSTGRES_USER=kynren
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=kynren_asset_register

# --- Auth secrets (use a different random value for each) ---
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
REFRESH_JWT_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_PLUS_RANDOM_SECRET

# --- Optional email (forgot-password flow) ---
# Leave blank to fall back to logging the reset link server-side instead of emailing it.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Kynren Asset Register <no-reply@your-domain.com>
