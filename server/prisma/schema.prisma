  url       String
  createdAt DateTime @default(now())
}

model KnowledgeArticle {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  category    String?
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])
