model ResourceSchedule {
  id            Int      @id @default(autoincrement())
  resourceName  String
  // Role/crew label shown under the resource's name in the dispatch grid (e.g. "Lead Stage
  // Tech") and the section it's grouped under (e.g. "Technicians & Crews" vs "Hardware &
  // Equipment") — denormalized onto every booking row rather than a separate Resource table
  // since resourceName was already free text with no roster entity behind it; the grid derives
  // its resource roster from the distinct (resourceName, role, groupLabel) seen across all
  // bookings ever made, so a resource "exists" the first time it's scheduled.
  role          String?
  groupLabel    String   @default("Technicians & Crews")
  title         String?
  color         String?
  scheduledById Int
  scheduledBy   User     @relation(fields: [scheduledById], references: [id])
  startAt       DateTime
  endAt         DateTime
  notes         String?
  createdAt     DateTime @default(now())
}

// ───────────────────────── Docs & SOPs ─────────────────────────

enum DocType {
  SOP
  WORK_INSTRUCTION
  TECHNICAL_RUNBOOK
  MAINTENANCE_CHECKLIST
  POLICY
  SHOW_PRODUCTION
  TRAINING
  GENERAL
}

// Every document belongs to exactly one collection (e.g. "Asset Register SOPs") — a simple named
// grouping, same shape as AssetCategory, used to organize the library beyond just docType/category.
model DocCollection {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  documents   Document[]
  createdAt   DateTime   @default(now())
}

// `sections` holds the docType-specific structured content as JSON (e.g. an SOP's
// purpose/scope/responsibilities/steps vs. a Maintenance Checklist's frequency/checklist
// items) — one flexible column instead of a dozen mostly-empty columns per type, rendered by a
// per-docType form/view on the client. Top-level "textarea" sections store WYSIWYG-authored HTML.
// `searchText` is a plain-text flattening (HTML stripped) of title + summary + every section +
// tags, regenerated on every write, and is what the full-text search index actually runs
// against — keeps the search query simple regardless of how deeply nested a given type's
// sections are.
// `externalKey` is a stable UUID assigned the first time a document is exported to the git repo
// (see lib/docsGitSync.ts) — it's the upsert key the VPS's import script matches on, since the
// auto-increment `id` isn't portable between separate databases.
model Document {
  id            Int                  @id @default(autoincrement())
  externalKey   String?              @unique
  title         String
  docType       DocType
  category      String
  collectionId  Int
  collection    DocCollection        @relation(fields: [collectionId], references: [id])
  summary       String?
  sections      Json
  tags          String[]             @default([])
  searchText    String
  isPublished   Boolean              @default(true)
  reviewDueDate DateTime?
  createdById   Int
  createdBy     User                 @relation(fields: [createdById], references: [id])
  attachments   DocumentAttachment[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([docType])
  @@index([category])
  @@index([collectionId])
}

model DocumentAttachment {
  id         Int      @id @default(autoincrement())
  documentId Int
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileName   String
  url        String
  createdAt  DateTime @default(now())
}

// ───────────────────────── System Status ─────────────────────────

enum SystemComponentStatus {
  OPERATIONAL
  DEGRADED
  OUTAGE
}

// One row per health-checked subsystem (API, database, email, NVR relay, network monitor — see
// lib/systemStatusMonitor.ts for the actual checks). Static-ish reference data upserted by the
// scheduler on first run; the interesting history lives in SystemComponentDailyStatus below.
// Singleton (id always 1), mirrors NetworkMonitorSettings/BackupSettings/EmailIngestSettings'
// pattern — one row controlling how often runSystemStatusCheck() actually re-checks every
// component (see systemStatusMonitor.ts's startSystemStatusScheduler()).
model SystemStatusSettings {
  id                   Int       @id @default(1)
  checkIntervalMinutes Int       @default(60)
  lastRunAt            DateTime?
  updatedById          Int?
  updatedBy            User?     @relation(fields: [updatedById], references: [id])
  updatedAt            DateTime  @updatedAt
}

model SystemComponent {
  id            Int                          @id @default(autoincrement())
  key           String                       @unique
  name          String
  sortOrder     Int                          @default(0)
  createdAt     DateTime                     @default(now())
  dailyStatuses SystemComponentDailyStatus[]
}

// One row per (component, calendar day in UTC) — upserted every time the periodic health check
// runs that day, so the Admin & Setup "System Status" uptime strip (styled after status.claude.com)
// is a simple date-range read instead of aggregating potentially thousands of individual check
// rows. `status` is the worst status observed that day (an outage anywhere in the day marks the
// whole day red, matching how public status pages summarize a day); checksOk/checksTotal back the
// displayed uptime percentage.
model SystemComponentDailyStatus {
  id          Int                   @id @default(autoincrement())
  componentId Int
  component   SystemComponent       @relation(fields: [componentId], references: [id], onDelete: Cascade)
  date        DateTime
  status      SystemComponentStatus @default(OPERATIONAL)
  checksOk    Int                   @default(0)
  checksTotal Int                   @default(0)
  lastMessage String?
  updatedAt   DateTime              @updatedAt

  @@unique([componentId, date])
  @@index([date])
}

// ───────────────────────── Database Backups ─────────────────────────
// Singleton schedule (same pattern as NetworkMonitorSettings) — when a pg_dump should run,
// reusing the day-of-week + time-of-day + lastRunDate dedup convention from
// LightingAutomation/lightingAutomationScheduler rather than inventing a cron parser.
model BackupSettings {
  id          Int      @id @default(1)
  isEnabled   Boolean  @default(false)
  daysOfWeek  Int[]    @default([])
  timeOfDay   String   @default("02:00")
  lastRunDate String?
  updatedById Int?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
}

enum BackupDestinationType {
  EMAIL
  S3
}

// A pending or completed edit to App Settings (system settings, backup schedule, or a role's
// permission matrix) made from the App Settings "Change Management" area — either applied
// immediately or deferred to a future scheduledFor time and picked up by
// lib/scheduledChangeScheduler.ts. payload/beforeSnapshot shapes vary by changeType (see
// modules/scheduledChanges/scheduledChanges.service.ts): SYSTEM_SETTINGS is `{values}` matching
// PUT /settings, BACKUP_SETTINGS matches PUT /backups/settings, ROLE_PERMISSIONS is
// `{permissions}` with targetId = the roleId being edited.
enum ScheduledChangeType {
  SYSTEM_SETTINGS
  BACKUP_SETTINGS
  ROLE_PERMISSIONS
}

enum ScheduledChangeStatus {
  PENDING
  PUBLISHED
  CANCELLED
  FAILED
}

model ScheduledChange {
  id             Int                   @id @default(autoincrement())
  changeType     ScheduledChangeType
  status         ScheduledChangeStatus @default(PENDING)
  summary        String
  payload        Json
  beforeSnapshot Json?
  targetId       Int?
  scheduledFor   DateTime
  createdById    Int
  createdBy      User                  @relation("ScheduledChangeCreatedBy", fields: [createdById], references: [id])
  publishedAt    DateTime?
  cancelledAt    DateTime?
  cancelledById  Int?
  cancelledBy    User?                 @relation("ScheduledChangeCancelledBy", fields: [cancelledById], references: [id])
  errorMessage   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status, scheduledFor])
  @@index([changeType, targetId])
}

// Per-notification-type customization of the in-app toast popped when a matching Notification
// (see notifyUsers() in lib/notify.ts) arrives while the recipient is active in the app. Keyed by
// Notification.type (a stable free-form string, e.g. "asset_assigned") rather than EmailEventType,
// since notification types cover several events (ticket comments, lighting automations) that have
// no corresponding email template. Missing rows fall back to NOTIFICATION_TYPES catalog defaults
// on the client — a row only needs to exist once an admin actually customizes that type.
model ToastSetting {
  id          Int      @id @default(autoincrement())
  type        String   @unique
  isEnabled   Boolean  @default(true)
  variant     String   @default("info")
  title       String?
  message     String?
  updatedById Int?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
}

// A place a completed backup gets pushed to. S3 fields cover any S3-compatible provider (AWS S3,
// MinIO, Backblaze B2, DigitalOcean Spaces, Cloudflare R2, Wasabi) via a configurable endpoint —
// there's no single "online drive" API, so S3 is the closest thing to a universal standard for
// self-hosted apps pushing backups to remote object storage. s3SecretAccessKey is encrypted at
// rest with the same AES-256-GCM helper used for NVR/device credentials.
model BackupDestination {
  id        Int                   @id @default(autoincrement())
  type      BackupDestinationType
  name      String
  isEnabled Boolean               @default(true)

  emailTo String?

  s3Endpoint        String?
  s3Region          String?
  s3Bucket          String?
  s3AccessKeyId     String?
  s3SecretAccessKey String?
  s3PathPrefix      String?
  s3ForcePathStyle  Boolean @default(false)

  lastTestAt      DateTime?
  lastTestOk      Boolean?
  lastTestMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries BackupRunDestination[]
}

enum BackupRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum BackupRunTrigger {
  SCHEDULED
  MANUAL
}

// One row per pg_dump attempt — the dump file itself is never kept on disk after delivery (it's
// streamed out to each destination and removed), so this is the only record that a backup ran.
model BackupRun {
  id            Int              @id @default(autoincrement())
  trigger       BackupRunTrigger
  status        BackupRunStatus  @default(RUNNING)
  fileSizeBytes Int?
  message       String?
  startedAt     DateTime         @default(now())
  finishedAt    DateTime?

  deliveries BackupRunDestination[]

  @@index([startedAt])
}

// Per-destination delivery result for a run — destinationId is nullable with onDelete: SetNull
// (name snapshotted separately) so history survives deleting the destination itself, same
// reasoning as LightingAutomationRun surviving automation deletion.
model BackupRunDestination {
  id              Int                   @id @default(autoincrement())
  runId           Int
  run             BackupRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  destinationId   Int?
  destination     BackupDestination?    @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  destinationName String
  destinationType BackupDestinationType
  ok              Boolean
  message         String?

  @@index([runId])
}

// A named, shareable bundle of app appearance choices — color palette plus the primary nav's
// position (sidebar or a horizontal bar under the header). Deliberately bundles both rather than
// two separate mechanisms: "change the look of the app" (colors) and "change the menu position"
// (layout) are both facets of one thing a user picks and can hand to a colleague, same as GLPI's
// palette selector but extended to also carry the layout choice. A user's `User.activeThemeId`
// points at whichever Theme (their own, or one shared with them) is currently applied; null means
// the app's built-in default look.
model AppearanceTheme {
  id                Int      @id @default(autoincrement())
  name              String
  createdById       Int
  createdBy         User     @relation("AppearanceThemeCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  navPosition       String   @default("sidebar") // "sidebar" | "topbar"
  primaryColor      String   @default("#1d4ed8")
  // Null = inherit the app's built-in default for that slot instead of overriding it (so a theme
  // can customize just the accent color and leave the sidebar/page background alone, for instance).
  sidebarBgColor    String?
  sidebarTextColor  String?
  pageBgColor       String?
  isDark            Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  shares        AppearanceThemeShare[]
  activeForUsers User[]                @relation("UserActiveTheme")

  @@index([createdById])
}

model AppearanceThemeShare {
  id               Int             @id @default(autoincrement())
  themeId          Int
  theme            AppearanceTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)
  sharedWithUserId Int
  sharedWithUser   User            @relation("AppearanceThemeShareUser", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())

  @@unique([themeId, sharedWithUserId])
}

// "What's new" release notes shown to a user the first time they load the app after a new entry
// is published — see changelog.routes.ts and client's ChangelogModal.tsx. id is the monotonic
// ordering key (avoids parsing semantic version strings); a user's read position is just the
// highest id they've been shown, stored via the generic UserPreference mechanism under the key
// "changelog.lastSeenId" rather than a dedicated column.
model ChangelogEntry {
  id          Int      @id @default(autoincrement())
  title       String
  summary     String?
  // Array of bullet-point strings.
  items       Json     @default("[]")
  publishedAt DateTime @default(now())
  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([publishedAt])
}
