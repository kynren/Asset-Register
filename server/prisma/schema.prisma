enum RecordAccessLevel {
  EDIT
  DELETE
}

// App-wide creator/editor/delete-access grant system: any creator-owned record type (identified
// by a plain string `entityType` tag rather than a typed Prisma relation, since a real relation
// per entity would mean a near-identical join table per module — see the now-retired
// ProjectCardEditor this replaces) can grant EDIT and/or DELETE access to specific users on top
// of the record's own creator. A grant's absence is not a denial by itself — callers combine this
// with their own "is the creator" / "is System Admin" checks (see server/src/lib/recordAccess.ts).
// Exactly one of userId/teamId is set per row (enforced at the application layer in
// server/src/lib/recordAccess.ts, same convention as ReportShare's sharedWithUserId/
// sharedWithTeamId) — a team grant applies to every current member of that team, resolved at
// check-time via TeamMember rather than fanned out into one row per member, so adding someone to
// a team retroactively picks up every record already shared with it.
model RecordAccessGrant {
  id          Int               @id @default(autoincrement())
  entityType  String
  entityId    Int
  userId      Int?
  user        User?             @relation("RecordAccessGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  teamId      Int?
  team        Team?             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  level       RecordAccessLevel
  grantedById Int
  grantedBy   User              @relation("RecordAccessGrantGrantedBy", fields: [grantedById], references: [id])
  createdAt   DateTime          @default(now())

  @@unique([entityType, entityId, userId, level])
  @@unique([entityType, entityId, teamId, level])
  @@index([entityType, entityId])
}

