generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Access control ─────────────────────────

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id        Int     @id @default(autoincrement())
  roleId    Int
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module    String
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)
  canExport Boolean @default(false)

  @@unique([roleId, module])
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  passwordHash       String
  firstName          String
  lastName           String
  avatarUrl          String?
  accentColor        String?
  roleId             Int
  role               Role      @relation(fields: [roleId], references: [id])
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  mfaSecret           String?
  mfaEnabled          Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime?

  assetsAssigned    Asset[]            @relation("AssetAssignee")
  ticketsRequested  Ticket[]           @relation("TicketRequester")
  ticketsAssigned   Ticket[]           @relation("TicketAssignee")
  ticketComments    TicketComment[]
  ticketAttachments TicketAttachment[]
  ticketWatching    TicketWatcher[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  stockTransactions StockTransaction[]
  networkScans      NetworkScan[]
  vaultEntries      VaultEntry[]
  images            UserImage[]
  dashboardLayout   DashboardLayout?
  preferences       UserPreference[]
  mcpApiKeys        McpApiKey[]

  projectCardsAssigned ProjectCard[]      @relation("ProjectCardAssignee")
  projectCardsCreated  ProjectCard[]      @relation("ProjectCardCreator")
  knowledgeArticles    KnowledgeArticle[]
  assetBookings        AssetBooking[]
  savedQueries         SavedQuery[]
  resourceSchedules    ResourceSchedule[]

  refreshSessions      RefreshSession[]
  passwordResetTokens  PasswordResetToken[]
  passwordHistory      PasswordHistory[]
  checkoutsReceived    AssetCheckout[]      @relation("CheckoutRecipient")
  checkoutsIssued      AssetCheckout[]      @relation("CheckoutIssuer")
  checkoutsProcessed   AssetCheckout[]      @relation("CheckoutReceiver")
  licenseAssignments   LicenseAssignment[]
  purchaseOrdersCreated PurchaseOrder[]
  emailTemplatesCreated EmailTemplate[]
  documentsCreated      Document[]
}

model RefreshSession {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model PasswordHistory {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())
}

model UserImage {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())
}

model VaultEntry {
  id                Int      @id @default(autoincrement())
  userId            Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  websiteUrl        String?
  username          String?
  encryptedPassword String
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DashboardLayout {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  layoutJson Json
  updatedAt  DateTime @updatedAt
}

// Generic per-user UI-state store (grid layouts, panel selections, collapsed states, etc.) so
// changes a user makes follow their account instead of resetting every session. One row per
// (user, key); `value` holds whatever shape that key's feature needs.
model UserPreference {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

// ───────────────────────── Assets ─────────────────────────

model AssetCategory {
  id              Int                @id @default(autoincrement())
  name            String             @unique
  isComputerAsset    Boolean         @default(false)
  isShowAsset        Boolean         @default(false)
  isSwitchingDevice  Boolean         @default(false)
  formTemplateId  Int?
  formTemplate    AssetFormTemplate? @relation(fields: [formTemplateId], references: [id])
  assets          Asset[]
}

model AssetFormTemplate {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  fields      AssetFormField[]
  categories  AssetCategory[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum AssetFormFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  CHECKBOX
}

model AssetFormField {
  id         Int                      @id @default(autoincrement())
  templateId Int
  template   AssetFormTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label      String
  fieldKey   String
  fieldType  AssetFormFieldType       @default(TEXT)
  required   Boolean                  @default(false)
  options    Json?
  order      Int                      @default(0)
  values     AssetCustomFieldValue[]
  createdAt  DateTime                 @default(now())

  @@unique([templateId, fieldKey])
}

model AssetCustomFieldValue {
  id      Int            @id @default(autoincrement())
  assetId Int
  asset   Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fieldId Int
  field   AssetFormField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value   String?

  @@unique([assetId, fieldId])
}

model Location {
  id         Int          @id @default(autoincrement())
  name       String       @unique
  address    String?
  assets     Asset[]
  stockItems StockItem[]
  stockLevels StockLevel[]
}

enum AssetStatus {
  IN_USE
  IN_STORAGE
  IN_REPAIR
  RETIRED
  LOST
}

enum SignOffStatus {
  PENDING
  CONFIRMED
}

model Asset {
  id                Int            @id @default(autoincrement())
  assetTag          String         @unique
  name              String
  categoryId        Int?
  category          AssetCategory? @relation(fields: [categoryId], references: [id])
  locationId        Int?
  location          Location?      @relation(fields: [locationId], references: [id])
  assignedToId      Int?
  assignedTo        User?          @relation("AssetAssignee", fields: [assignedToId], references: [id])
  status            AssetStatus    @default(IN_USE)
  manufacturer      String?
  model             String?
  serialNumber      String?
  purchaseDate      DateTime?
  purchaseCost      Decimal?       @db.Decimal(12, 2)
  warrantyExpiresAt DateTime?
  nextServiceDate   DateTime?
  notes             String?
  signOffStatus     SignOffStatus  @default(PENDING)
  deviceId          Int?           @unique
  device            Device?        @relation(fields: [deviceId], references: [id])
  tickets           Ticket[]

  featuredImageUrl  String?
  gridPowered       Boolean        @default(true)

  remoteManagementEnabled  Boolean  @default(false)
  remoteManagementProtocol String?
  remoteManagementUrl      String?

  staticIpAddress String?
  subnetMask      String?
  defaultGateway  String?
  dnsServers      String?

  isVirtual  Boolean @default(false)
  hypervisor String?
  vmHost     String?

  antivirusProduct    String?
  antivirusStatus     String?
  antivirusLastScanAt DateTime?

  photos       AssetPhoto[]
  components   AssetComponent[]
  volumes      AssetVolume[]
  connections  AssetConnection[]
  networkPorts AssetNetworkPort[]
  sockets      AssetSocket[]
  contracts    AssetContract[]
  documents    AssetDocument[]
  bookings     AssetBooking[]
  checkouts    AssetCheckout[]
  licenseAssignments LicenseAssignment[]
  customFieldValues AssetCustomFieldValue[]
  switchPorts        SwitchPort[]        @relation("SwitchOwnedPorts")
  connectedViaPorts  SwitchPort[]        @relation("SwitchPortConnectedAsset")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ───────────────────────── Switching (switches/routers port mapping) ─────────────────────────

enum PortStatus {
  UP
  DOWN
  DISABLED
}

model SwitchPort {
  id               Int         @id @default(autoincrement())
  assetId          Int
  asset            Asset       @relation("SwitchOwnedPorts", fields: [assetId], references: [id], onDelete: Cascade)
  portNumber       Int
  label            String?
  status           PortStatus  @default(DOWN)
  vlan             String?
  connectedAssetId Int?
  connectedAsset   Asset?      @relation("SwitchPortConnectedAsset", fields: [connectedAssetId], references: [id], onDelete: SetNull)
  notes            String?
  updatedAt        DateTime    @updatedAt

  @@unique([assetId, portNumber])
}

model AssetCheckout {
  id             Int       @id @default(autoincrement())
  assetId        Int
  asset          Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  checkedOutToId Int
  checkedOutTo   User      @relation("CheckoutRecipient", fields: [checkedOutToId], references: [id])
  checkedOutById Int
  checkedOutBy   User      @relation("CheckoutIssuer", fields: [checkedOutById], references: [id])
  checkedOutAt   DateTime  @default(now())
  dueBackAt      DateTime?
  checkedInAt    DateTime?
  checkedInById  Int?
  checkedInBy    User?     @relation("CheckoutReceiver", fields: [checkedInById], references: [id])
  notes          String?
}

model License {
  id           Int      @id @default(autoincrement())
  name         String
  vendor       String?
  licenseKey   String?
  seats        Int      @default(1)
  purchaseDate DateTime?
  expiresAt    DateTime?
  cost         Decimal? @db.Decimal(12, 2)
  notes        String?
  assignments  LicenseAssignment[]
  createdAt    DateTime @default(now())
}

model LicenseAssignment {
  id         Int      @id @default(autoincrement())
  licenseId  Int
  license    License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  assetId    Int?
  asset      Asset?   @relation(fields: [assetId], references: [id])
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  assignedAt DateTime @default(now())
}

model AssetPhoto {
  id        Int      @id @default(autoincrement())
  assetId   Int
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())
}

model AssetComponent {
  id        Int      @id @default(autoincrement())
  assetId   Int
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type      String
  name      String
  details   String?
  createdAt DateTime @default(now())
}

model AssetVolume {
  id         Int      @id @default(autoincrement())
  assetId    Int
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  label      String
  totalGb    Float?
  freeGb     Float?
  fileSystem String?
  createdAt  DateTime @default(now())
}

model AssetConnection {
  id        Int      @id @default(autoincrement())
  assetId   Int
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  label     String
  type      String?
  target    String?
  createdAt DateTime @default(now())
}

model AssetNetworkPort {
  id          Int      @id @default(autoincrement())
  assetId     Int
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  portNumber  Int
  protocol    String?
  serviceName String?
  status      String?
  createdAt   DateTime @default(now())
}

model AssetSocket {
  id        Int      @id @default(autoincrement())
  assetId   Int
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  label     String
  type      String?
  location  String?
  createdAt DateTime @default(now())
}

model AssetContract {
  id             Int       @id @default(autoincrement())
  assetId        Int
  asset          Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  vendor         String
  contractNumber String?
  startDate      DateTime?
  endDate        DateTime?
  fileUrl        String?
  notes          String?
  createdAt      DateTime  @default(now())
}

model AssetDocument {
  id        Int      @id @default(autoincrement())
  assetId   Int
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  name      String
  fileUrl   String
  sizeBytes Int?
  createdAt DateTime @default(now())
}

// ───────────────────────── Devices (agent-reported) ─────────────────────────

model Device {
  id                 Int       @id @default(autoincrement())
  hostname           String
  macAddress         String    @unique
  ipAddresses        String[]
  os                 String?
  osVersion          String?
  cpu                String?
  ramGb              Float?
  diskInfo           String?
  manufacturer       String?
  model              String?
  serialNumber       String?
  agentVersion       String?
  loggedInUser       String?
  lastLoginAt        DateTime?
  installedSoftware  Json?
  batteryPresent     Boolean?
  batteryPercent     Int?
  batteryCharging    Boolean?
  lastSeen           DateTime  @default(now())
  createdAt          DateTime  @default(now())

  asset       Asset?
  networkNode NetworkNode?
}

// ───────────────────────── Network topology ─────────────────────────

enum NodeType {
  DEVICE
  ROUTER
  SWITCH
  NVR
  OTHER
}

enum NodeRole {
  CORE_SWITCH
  DISTRIBUTION_SWITCH
  EDGE_SWITCH
  GATEWAY_ROUTER
  HARDWARE_HOST
}

model NetworkNode {
  id         Int       @id @default(autoincrement())
  type       NodeType
  role       NodeRole?
  label      String
  ipAddress  String?
  subnet     String?
  vendor     String?
  deviceType String?
  deviceId   Int?      @unique
  device     Device?   @relation(fields: [deviceId], references: [id])
  posX       Float?
  posY       Float?
  createdAt  DateTime  @default(now())

  edgesFrom NetworkEdge[] @relation("EdgeSource")
  edgesTo   NetworkEdge[] @relation("EdgeTarget")
}

model NetworkEdge {
  id            Int         @id @default(autoincrement())
  sourceId      Int
  source        NetworkNode @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId      Int
  target        NetworkNode @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)
  label         String?
  bandwidthMbps Float?
}

enum ScanStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model NetworkScan {
  id          Int                 @id @default(autoincrement())
  startIp     String
  endIp       String
  status      ScanStatus          @default(RUNNING)
  totalHosts  Int
  aliveHosts  Int                 @default(0)
  scannedHosts Int                @default(0)
  startedById Int
  startedBy   User                @relation(fields: [startedById], references: [id])
  startedAt   DateTime            @default(now())
  completedAt DateTime?
  results     NetworkScanResult[]
}

model NetworkScanResult {
  id             Int         @id @default(autoincrement())
  scanId         Int
  scan           NetworkScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  ipAddress      String
  alive          Boolean
  hostname       String?
  macAddress     String?
  vendor         String?
  deviceType     String?
  responseTimeMs Int?
  openPorts      Int[]
  discoveredAt   DateTime    @default(now())
}

// ───────────────────────── Stock ─────────────────────────

enum StockTxType {
  IN
  OUT
  TRANSFER
}

model StockItem {
  id             Int                @id @default(autoincrement())
  sku            String             @unique
  name           String
  category       String?
  unit           String             @default("pcs")
  quantityOnHand Int                @default(0)
  reorderLevel   Int                @default(0)
  unitCost       Decimal?           @db.Decimal(12, 2)
  locationId     Int?
  location       Location?          @relation(fields: [locationId], references: [id])
  stockLevels    StockLevel[]
  transactions   StockTransaction[]
  purchaseOrderItems PurchaseOrderItem[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

// Per-location quantity breakdown for a StockItem. StockItem.quantityOnHand
// remains the synced total across all locations for backward-compatible
// consumers (dashboard, low-stock, reports); this table is the source of
// truth for "how much is at location X".
model StockLevel {
  id             Int       @id @default(autoincrement())
  stockItemId    Int
  stockItem      StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  locationId     Int
  location       Location  @relation(fields: [locationId], references: [id])
  quantityOnHand Int       @default(0)
  reorderLevel   Int       @default(0)
  updatedAt      DateTime  @updatedAt

  @@unique([stockItemId, locationId])
}

model StockTransaction {
  id             Int         @id @default(autoincrement())
  stockItemId    Int
  stockItem      StockItem   @relation(fields: [stockItemId], references: [id])
  type           StockTxType
  quantity       Int
  reason         String?
  fromLocationId Int?
  toLocationId   Int?
  performedById  Int
  performedBy    User        @relation(fields: [performedById], references: [id])
  createdAt      DateTime    @default(now())
}

model Supplier {
  id             Int             @id @default(autoincrement())
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  notes          String?
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          Int                 @id @default(autoincrement())
  poNumber    String              @unique
  supplierId  Int
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  status      PurchaseOrderStatus @default(DRAFT)
  orderedAt   DateTime?
  expectedAt  DateTime?
  notes       String?
  createdById Int
  createdBy   User                @relation(fields: [createdById], references: [id])
  items       PurchaseOrderItem[]
  createdAt   DateTime            @default(now())
}

model PurchaseOrderItem {
  id               Int           @id @default(autoincrement())
  purchaseOrderId  Int
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  stockItemId      Int
  stockItem        StockItem     @relation(fields: [stockItemId], references: [id])
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCost         Decimal?      @db.Decimal(12, 2)
}

// ───────────────────────── Helpdesk ─────────────────────────

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model TicketCategory {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  tickets Ticket[]
}

model Ticket {
  id                   Int                @id @default(autoincrement())
  ticketNumber         String             @unique
  title                String
  description          String
  status               TicketStatus       @default(OPEN)
  priority             TicketPriority     @default(MEDIUM)
  categoryId           Int?
  category             TicketCategory?    @relation(fields: [categoryId], references: [id])
  assetId              Int?
  asset                Asset?             @relation(fields: [assetId], references: [id])
  requesterId          Int
  requester            User               @relation("TicketRequester", fields: [requesterId], references: [id])
  assigneeId           Int?
  assignee             User?              @relation("TicketAssignee", fields: [assigneeId], references: [id])
  dueAt                DateTime?
  satisfactionRating   Int?
  satisfactionComment  String?
  comments             TicketComment[]
  attachments          TicketAttachment[]
  watchers             TicketWatcher[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  resolvedAt           DateTime?
}

model TicketComment {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   Int
  author     User     @relation(fields: [authorId], references: [id])
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model TicketAttachment {
  id           Int      @id @default(autoincrement())
  ticketId     Int
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  filename     String
  storedPath   String
  sizeBytes    Int
  uploadedById Int
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model TicketWatcher {
  id       Int    @id @default(autoincrement())
  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   Int
  user     User   @relation(fields: [userId], references: [id])

  @@unique([ticketId, userId])
}

// ───────────────────────── NVR / Cameras ─────────────────────────

enum CameraStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

model Nvr {
  id                Int          @id @default(autoincrement())
  name              String
  ipAddress         String?
  port              Int?
  protocol          String?      @default("RTSP")
  username          String?
  encryptedPassword String?
  location          String?
  model             String?
  notes             String?
  status            CameraStatus @default(UNKNOWN)
  lastCheckedAt     DateTime?
  cameras           Camera[]
  events            CameraEvent[]
  createdAt         DateTime     @default(now())
}

model Camera {
  id                Int           @id @default(autoincrement())
  nvrId             Int
  nvr               Nvr           @relation(fields: [nvrId], references: [id], onDelete: Cascade)
  name              String
  channel           Int?
  location          String?
  ipAddress         String?
  port              Int?
  username          String?
  encryptedPassword String?
  streamUrl         String?
  ptzEnabled        Boolean       @default(false)
  status            CameraStatus  @default(UNKNOWN)
  lastCheckedAt     DateTime?
  events            CameraEvent[]
  recordings        CameraRecording[]
}

model CameraRecording {
  id        Int       @id @default(autoincrement())
  cameraId  Int
  camera    Camera    @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  filePath  String
  startedAt DateTime
  endedAt   DateTime?
  sizeBytes Int?
  trigger   String
  createdAt DateTime  @default(now())
}

model CameraEvent {
  id        Int      @id @default(autoincrement())
  nvrId     Int?
  nvr       Nvr?     @relation(fields: [nvrId], references: [id], onDelete: Cascade)
  cameraId  Int?
  camera    Camera?  @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  type      String
  message   String?
  createdAt DateTime @default(now())
}

// ───────────────────────── Cross-cutting ─────────────────────────

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   Int?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
}

enum EmailEventType {
  ACCOUNT_CREATED
  ASSET_ASSIGNED
  PASSWORD_RESET
  TASK_OVERDUE
  LOW_STOCK
}

// Blocks is an ordered array of { id, type, ...type-specific fields } — rendered to HTML by
// server/src/lib/emailTemplateRenderer.ts. Only one template per eventType is ever "active"
// (enforced in the controller, not the DB) — that's the one sendEventEmail() picks up; the rest
// are drafts/alternates an admin can keep around and swap in later.
model EmailTemplate {
  id          Int            @id @default(autoincrement())
  name        String
  eventType   EmailEventType
  subject     String
  blocks      Json
  isActive    Boolean        @default(false)
  createdById Int
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([eventType])
}

model SystemSetting {
  key   String @id
  value String
}

model AgentApiKey {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  label     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Bearer key for external MCP clients (Claude Desktop, Claude Code, etc.) connecting to this
// app's MCP server at /api/mcp. Tied to a real user so any write actions the client performs
// (e.g. creating a ticket) are attributed to that account, same as everything else in the app.
model McpApiKey {
  id         Int       @id @default(autoincrement())
  key        String    @unique
  label      String?
  ownerId    Int
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

