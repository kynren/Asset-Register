generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Access control ─────────────────────────

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id        Int     @id @default(autoincrement())
  roleId    Int
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module    String
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)
  canExport Boolean @default(false)
  canImport Boolean @default(false)
  // Only consulted for module="helpdesk" today: when true, a holder of this role only sees tickets
  // they're assigned to or requested, instead of every ticket canView would otherwise grant.
  scopeAssignedOnly Boolean @default(false)

  @@unique([roleId, module])
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  passwordHash       String
  pinHash            String?
  pinEnabled         Boolean   @default(false)
  firstName          String
  lastName           String
  avatarUrl          String?
  accentColor        String?
  roleId             Int
  role               Role      @relation(fields: [roleId], references: [id])
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  mfaSecret           String?
  mfaEnabled          Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime?

  assetsAssigned    Asset[]            @relation("AssetAssignee")
  ticketsRequested  Ticket[]           @relation("TicketRequester")
  ticketAssignments TicketAssignee[]
  ticketComments    TicketComment[]
  ticketAttachments TicketAttachment[]
  ticketWatching    TicketWatcher[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  stockTransactions StockTransaction[]
  networkScans      NetworkScan[]
  vaultEntries      VaultEntry[]
  images            UserImage[]
  dashboardsOwned         Dashboard[]      @relation("DashboardOwner")
  dashboardSharesReceived DashboardShare[] @relation("DashboardShareUser")
  savedViewsOwned         SavedView[]      @relation("SavedViewOwner")
  savedViewSharesReceived SavedViewShare[] @relation("SavedViewShareUser")
  reportsOwned            Report[]         @relation("ReportOwner")
  reportSharesReceived    ReportShare[]    @relation("ReportShareUser")
  approvalSubstituteDelegations TicketApprovalSubstitute[] @relation("ApprovalSubstituteDelegator")
  approvalSubstituteAssignments TicketApprovalSubstitute[] @relation("ApprovalSubstituteDelegate")
  contactEmails           UserContactEmail[]
  preferences             UserPreference[]
  mcpApiKeys        McpApiKey[]

  projectCardsAssigned ProjectCard[]      @relation("ProjectCardAssignee")
  projectCardsCreated  ProjectCard[]      @relation("ProjectCardCreator")
  projectCardAttachmentsUploaded ProjectCardAttachment[] @relation("ProjectCardAttachmentUploader")
  recordAccessGrantsReceived RecordAccessGrant[] @relation("RecordAccessGrantUser")
  recordAccessGrantsGiven    RecordAccessGrant[] @relation("RecordAccessGrantGrantedBy")
  net2ServersCreated         Net2Server[]
  knowledgeArticles    KnowledgeArticle[]
  assetBookings        AssetBooking[]
  savedQueries         SavedQuery[]
  resourceSchedules    ResourceSchedule[]

  refreshSessions               RefreshSession[]
  passwordResetTokens           PasswordResetToken[]
  magicLoginTokens              MagicLoginToken[]        @relation("MagicLoginTokenUser")
  magicLoginTokensCreated       MagicLoginToken[]        @relation("MagicLoginTokenCreatedBy")
  passwordHistory               PasswordHistory[]
  checkoutsReceived             AssetCheckout[]          @relation("CheckoutRecipient")
  checkoutsIssued               AssetCheckout[]          @relation("CheckoutIssuer")
  checkoutsProcessed            AssetCheckout[]          @relation("CheckoutReceiver")
  licenseAssignments            LicenseAssignment[]
  purchaseOrdersCreated         PurchaseOrder[]
  emailTemplatesCreated         EmailTemplate[]
  loginPageDesignsUpdated       LoginPageDesign[]
  documentsCreated              Document[]
  networkMonitorSettingsUpdates NetworkMonitorSettings[]
  backupSettingsUpdates         BackupSettings[]
  toastSettingUpdates           ToastSetting[]
  scheduledChangesCreated       ScheduledChange[]        @relation("ScheduledChangeCreatedBy")
  scheduledChangesCancelled     ScheduledChange[]        @relation("ScheduledChangeCancelledBy")
  teamMemberships               TeamMember[]
  emailIngestFallbackFor        EmailIngestSettings[]
  systemStatusSettingsUpdates   SystemStatusSettings[]
  notificationPreferences       NotificationPreference[]

  ticketTasksAssigned      TicketTask[]      @relation("TicketTaskAssignee")
  ticketTasksAuthored      TicketTask[]      @relation("TicketTaskAuthor")
  ticketSolutionsAuthored  TicketSolution[]  @relation("TicketSolutionAuthor")
  ticketSolutionsAnswered  TicketSolution[]  @relation("TicketSolutionAnswerer")
  ticketApprovalsRequested TicketApproval[]  @relation("TicketApprovalRequester")
  ticketApprovalsTargeted  TicketApproval[]  @relation("TicketApprovalTargetUser")
  ticketApprovalsAnswered  TicketApproval[]  @relation("TicketApprovalAnswerer")
  ticketRecurrencesOwned   TicketRecurrence[] @relation("TicketRecurrenceRequester")

  // Personal appearance (color palette + sidebar/topbar layout) — a user picks one saved
  // AppearanceTheme (their own, or one shared with them) as "active"; null means the app's
  // default look. See AppearanceTheme below.
  activeThemeId               Int?
  activeTheme                 AppearanceTheme?        @relation("UserActiveTheme", fields: [activeThemeId], references: [id], onDelete: SetNull)
  appearanceThemesCreated     AppearanceTheme[]       @relation("AppearanceThemeCreatedBy")
  appearanceThemeSharesReceived AppearanceThemeShare[] @relation("AppearanceThemeShareUser")

  changelogEntriesCreated ChangelogEntry[]
}

model RefreshSession {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  // Set when a System Admin re-verifies their password/PIN to switch into a given organization —
  // lets the client skip re-prompting for the same org until this expires (or this session ends).
  // A non-null orgSwitchConfirmedOrgId with a null Until means "confirmed until logout" (no timer).
  orgSwitchConfirmedOrgId  Int?
  orgSwitchConfirmedUntil  DateTime?
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// One-time, short-lived login token an admin can generate for a user from their User Detail page
// — emailed to the user, and consuming it (POST /auth/magic-login) logs them straight in without
// a password, same session-issuing path as a normal login. createdById records which admin sent
// it, since (unlike self-service forgot-password) this is one account acting on another's behalf.
model MagicLoginToken {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation("MagicLoginTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById Int
  createdBy   User      @relation("MagicLoginTokenCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
}

model PasswordHistory {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())
}

model UserImage {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())
}

model VaultEntry {
  id                Int      @id @default(autoincrement())
  userId            Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  websiteUrl        String?
  username          String?
  encryptedPassword String
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// A named, per-module widget dashboard. "home" is the original whole-app Dashboard; other modules
// are the per-page dashboards (assets, helpdesk, stock, network, docs). A user can own any number
// of dashboards per module (switchable via a picker on that page) — this superseded the older
// one-row-per-(user,module) DashboardLayout once dashboards needed names and sharing.
model Dashboard {
  id         Int      @id @default(autoincrement())
  name       String
  module     String   @default("home")
  ownerId    Int
  owner      User     @relation("DashboardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  layoutJson Json
  // The dashboard that opens by default when the owner visits that module's page — exactly one
  // per (ownerId, module) is enforced in application code (Prisma partial-unique-index support is
  // provider-limited, so this is checked the same way other single-default-per-scope flags in this
  // codebase are).
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shares DashboardShare[]

  @@index([ownerId, module])
}

// Grants a specific user or a whole team access to someone else's Dashboard. Exactly one of
// sharedWithUserId/sharedWithTeamId is set (enforced in dashboards.schema.ts, mirroring how other
// either/or relations in this schema are validated at the API layer rather than via DB check
// constraints). canEdit is chosen per-share by the owner at share time.
model DashboardShare {
  id               Int       @id @default(autoincrement())
  dashboardId      Int
  dashboard        Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  sharedWithUserId Int?
  sharedWithUser   User?     @relation("DashboardShareUser", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  sharedWithTeamId Int?
  sharedWithTeam   Team?     @relation(fields: [sharedWithTeamId], references: [id], onDelete: Cascade)
  canEdit          Boolean   @default(false)
  createdAt        DateTime  @default(now())

  @@unique([dashboardId, sharedWithUserId])
  @@unique([dashboardId, sharedWithTeamId])
}

// A named, saved filter/column/sort/view-mode preset for a specific DataTable (identified by that
// table's own `tableId` prop, e.g. "assets.category.9") — GLPI's "Saved Search" concept. `filters`
// is an opaque JSON blob whose shape is entirely owned by whichever page wires SavedViewBar in;
// this model only owns naming, ownership, defaulting, and sharing, mirroring Dashboard/
// DashboardShare exactly so both features share one mental model.
model SavedView {
  id        Int      @id @default(autoincrement())
  name      String
  tableId   String
  ownerId   Int
  owner     User     @relation("SavedViewOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  filters   Json
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shares SavedViewShare[]

  @@index([ownerId, tableId])
}

model SavedViewShare {
  id               Int       @id @default(autoincrement())
  savedViewId      Int
  savedView        SavedView @relation(fields: [savedViewId], references: [id], onDelete: Cascade)
  sharedWithUserId Int?
  sharedWithUser   User?     @relation("SavedViewShareUser", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  sharedWithTeamId Int?
  sharedWithTeam   Team?     @relation(fields: [sharedWithTeamId], references: [id], onDelete: Cascade)
  canEdit          Boolean   @default(false)
  createdAt        DateTime  @default(now())

  @@unique([savedViewId, sharedWithUserId])
  @@unique([savedViewId, sharedWithTeamId])
}

// A saved Report Builder configuration (data source + filters + columns + visualization) — reuses
// the same dataExplorer SOURCES/runQuery engine that powers dashboard Custom Query widgets, and
// mirrors Dashboard/SavedView's owner+share shape exactly. `filters`/`columns` are opaque JSON
// blobs whose shape is owned by the reports module (dataExplorer.FilterSpec / string[] of column
// keys) — null `columns` means "use the source's default columns".
model Report {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  source        String
  filters       Json?
  columns       Json?
  groupBy       String?
  visualization String   @default("table")
  sortBy        String?
  sortDir       String   @default("asc")
  ownerId       Int
  owner         User     @relation("ReportOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shares ReportShare[]

  @@index([ownerId])
}

model ReportShare {
  id               Int      @id @default(autoincrement())
  reportId         Int
  report           Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sharedWithUserId Int?
  sharedWithUser   User?    @relation("ReportShareUser", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  sharedWithTeamId Int?
  sharedWithTeam   Team?    @relation(fields: [sharedWithTeamId], references: [id], onDelete: Cascade)
  canEdit          Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@unique([reportId, sharedWithUserId])
  @@unique([reportId, sharedWithTeamId])
}

// Additional contact email addresses beyond the login/primary email — GLPI's UserEmail concept.
// Purely informational contact info today (not consumed for auth or notification routing).
model UserContactEmail {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  label     String?
  createdAt DateTime @default(now())
}

// Generic per-user UI-state store (grid layouts, panel selections, collapsed states, etc.) so
// changes a user makes follow their account instead of resetting every session. One row per
// (user, key); `value` holds whatever shape that key's feature needs.
model UserPreference {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

// ───────────────────────── Assets ─────────────────────────

model AssetCategory {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  isComputerAsset   Boolean            @default(false)
  isShowAsset       Boolean            @default(false)
  isSwitchingDevice Boolean            @default(false)
  formTemplateId    Int?
  formTemplate      AssetFormTemplate? @relation(fields: [formTemplateId], references: [id])
  collectionId      Int?
  collection        AssetCollection?   @relation(fields: [collectionId], references: [id])
  assets            Asset[]
  // null = the generic default column set (see client/src/pages/assets/assetTableColumns.ts).
  // A JSON array of column keys — generic keys (e.g. "status") or "field:<fieldKey>" for a custom
  // field from this category's formTemplate.
  tableColumns      Json?
  // null = legacy/default behavior (Components tab follows isComputerAsset; Contracts, Documents,
  // and Financial Info always shown) — see client/src/pages/assets/assetCapacities.ts. A JSON
  // string array of independently toggleable capacity keys ("components","contracts","documents",
  // "financialInfo") once an admin opts a category into explicit control via Configure Capacities.
  capacities        Json?
}

model AssetCollection {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  description String?
  createdAt   DateTime        @default(now())
  categories  AssetCategory[]
}

model AssetFormTemplate {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  fields      AssetFormField[]
  categories  AssetCategory[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum AssetFormFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  CHECKBOX
}

model AssetFormField {
  id         Int                     @id @default(autoincrement())
  templateId Int
  template   AssetFormTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label      String
  fieldKey   String
  fieldType  AssetFormFieldType      @default(TEXT)
  required   Boolean                 @default(false)
  options    Json?
  order      Int                     @default(0)
  values     AssetCustomFieldValue[]
  createdAt  DateTime                @default(now())

  @@unique([templateId, fieldKey])
}

model AssetCustomFieldValue {
  id      Int            @id @default(autoincrement())
  assetId Int
  asset   Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fieldId Int
  field   AssetFormField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value   String?

  @@unique([assetId, fieldId])
}

model Location {
  id                   Int                   @id @default(autoincrement())
  name                 String                @unique
  address              String?
  assets               Asset[]
  stockItems           StockItem[]
  stockLevels          StockLevel[]
  nvrs                 Nvr[]
  cameras              Camera[]
  accessControlDevices AccessControlDevice[]
  lightingDevices      LightingDevice[]
  zigbeeDevices        ZigbeeDevice[]
  tickets              Ticket[]
}

enum AssetStatus {
  IN_USE
  IN_STORAGE
  IN_REPAIR
  RETIRED
  LOST
}

enum SignOffStatus {
  PENDING
  CONFIRMED
}

model Asset {
  id                Int            @id @default(autoincrement())
  assetTag          String         @unique
  name              String
  categoryId        Int?
  category          AssetCategory? @relation(fields: [categoryId], references: [id])
  locationId        Int?
  location          Location?      @relation(fields: [locationId], references: [id])
  assignedToId      Int?
  assignedTo        User?          @relation("AssetAssignee", fields: [assignedToId], references: [id])
  status            AssetStatus    @default(IN_USE)
  manufacturer      String?
  model             String?
  serialNumber      String?
  // Filled in automatically when the IP Range Scanner / continuous Monitoring discovers a device
  // whose hostname matches this asset's name/assetTag — see enrichAssetFromScan() in
  // scan.service.ts. Manually enterable too; auto-fill never overwrites an existing value except
  // loggedInUser, which reflects live status rather than a fixed attribute.
  os                String?
  loggedInUser      String?
  purchaseDate      DateTime?
  purchaseCost      Decimal?       @db.Decimal(12, 2)
  warrantyExpiresAt DateTime?
  nextServiceDate   DateTime?
  // Financial & Administrative Information tab (see client AssetFinancialTab) — kept as plain
  // scalar fields on Asset rather than a separate Infocom-style table since this app's assets
  // don't need per-item amortization/depreciation tracking, just a place to record who it was
  // bought from and under what reference.
  supplier          String?
  invoiceNumber     String?
  notes             String?
  signOffStatus     SignOffStatus  @default(PENDING)
  deviceId          Int?           @unique
  device            Device?        @relation(fields: [deviceId], references: [id])
  tickets           Ticket[]

  featuredImageUrl String?
  gridPowered      Boolean @default(true)

  remoteManagementEnabled  Boolean @default(false)
  remoteManagementProtocol String?
  remoteManagementUrl      String?

  staticIpAddress String?
  subnetMask      String?
  defaultGateway  String?
  dnsServers      String?

  isVirtual  Boolean @default(false)
  hypervisor String?
  vmHost     String?

  antivirusProduct    String?
  antivirusStatus     String?
  antivirusLastScanAt DateTime?

  photos             AssetPhoto[]
  components         AssetComponent[]
  volumes            AssetVolume[]
  connections        AssetConnection[]
  networkPorts       AssetNetworkPort[]
  sockets            AssetSocket[]
  contracts          AssetContract[]
  documents          AssetDocument[]
  bookings           AssetBooking[]
  checkouts          AssetCheckout[]
  licenseAssignments LicenseAssignment[]
  customFieldValues  AssetCustomFieldValue[]
  switchPorts        SwitchPort[]            @relation("SwitchOwnedPorts")
  connectedViaPorts  SwitchPort[]            @relation("SwitchPortConnectedAsset")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ───────────────────────── Switching (switches/routers port mapping) ─────────────────────────

enum PortStatus {
  UP
  DOWN
  DISABLED
}

model SwitchPort {
  id               Int        @id @default(autoincrement())
  assetId          Int
  asset            Asset      @relation("SwitchOwnedPorts", fields: [assetId], references: [id], onDelete: Cascade)
  portNumber       Int
  label            String?
  status           PortStatus @default(DOWN)
  vlan             String?
  connectedAssetId Int?
  connectedAsset   Asset?     @relation("SwitchPortConnectedAsset", fields: [connectedAssetId], references: [id], onDelete: SetNull)
  notes            String?
  updatedAt        DateTime   @updatedAt

  @@unique([assetId, portNumber])
}

model AssetCheckout {
  id             Int       @id @default(autoincrement())
  assetId        Int
  asset          Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  checkedOutToId Int
  checkedOutTo   User      @relation("CheckoutRecipient", fields: [checkedOutToId], references: [id])
  checkedOutById Int
  checkedOutBy   User      @relation("CheckoutIssuer", fields: [checkedOutById], references: [id])
  checkedOutAt   DateTime  @default(now())
  dueBackAt      DateTime?
  checkedInAt    DateTime?
  checkedInById  Int?
  checkedInBy    User?     @relation("CheckoutReceiver", fields: [checkedInById], references: [id])
  notes          String?
}

model License {
  id           Int                 @id @default(autoincrement())
  name         String
  vendor       String?
  licenseKey   String?
  seats        Int                 @default(1)
  purchaseDate DateTime?
  expiresAt    DateTime?
  cost         Decimal?            @db.Decimal(12, 2)
  notes        String?
  assignments  LicenseAssignment[]
  createdAt    DateTime            @default(now())
}

model LicenseAssignment {
  id         Int      @id @default(autoincrement())
  licenseId  Int
  license    License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  assetId    Int?
  asset      Asset?   @relation(fields: [assetId], references: [id])
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  assignedAt DateTime @default(now())
}

model AssetPhoto {
  id        Int      @id @default(autoincrement())
  assetId   Int
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())
}

model AssetComponent {
  id        Int      @id @default(autoincrement())
  assetId   Int
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type      String
  name      String
  details   String?
  createdAt DateTime @default(now())
}

model AssetVolume {
  id         Int      @id @default(autoincrement())
  assetId    Int
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  label      String
  totalGb    Float?
  freeGb     Float?
  fileSystem String?
  createdAt  DateTime @default(now())
}

model AssetConnection {
  id        Int      @id @default(autoincrement())
  assetId   Int
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  label     String
  type      String?
  target    String?
  createdAt DateTime @default(now())
}

model AssetNetworkPort {
  id          Int      @id @default(autoincrement())
  assetId     Int
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  portNumber  Int
  protocol    String?
  serviceName String?
  status      String?
  createdAt   DateTime @default(now())
}

model AssetSocket {
  id        Int      @id @default(autoincrement())
  assetId   Int
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  label     String
  type      String?
  location  String?
  createdAt DateTime @default(now())
}

model AssetContract {
  id             Int       @id @default(autoincrement())
  assetId        Int
  asset          Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  vendor         String
  contractNumber String?
  startDate      DateTime?
  endDate        DateTime?
  fileUrl        String?
  notes          String?
  createdAt      DateTime  @default(now())
}

model AssetDocument {
  id        Int      @id @default(autoincrement())
  assetId   Int
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  name      String
  fileUrl   String
  sizeBytes Int?
  createdAt DateTime @default(now())
}

// ───────────────────────── Devices (agent-reported) ─────────────────────────

model Device {
  id                Int       @id @default(autoincrement())
  hostname          String
  macAddress        String    @unique
  ipAddresses       String[]
  subnetMask        String?
  defaultGateway    String?
  dnsServers        String?
  os                String?
  osVersion         String?
  cpu               String?
  ramGb             Float?
  diskInfo          String?
  manufacturer      String?
  model             String?
  serialNumber      String?
  agentVersion      String?
  loggedInUser      String?
  lastLoginAt       DateTime?
  installedSoftware Json?
  batteryPresent    Boolean?
  batteryPercent    Int?
  batteryCharging   Boolean?
  lastSeen          DateTime  @default(now())
  createdAt         DateTime  @default(now())

  asset       Asset?
  networkNode NetworkNode?
}

// ───────────────────────── Network topology ─────────────────────────

enum NodeType {
  DEVICE
  ROUTER
  SWITCH
  NVR
  OTHER
}

enum NodeRole {
  CORE_SWITCH
  DISTRIBUTION_SWITCH
  EDGE_SWITCH
  GATEWAY_ROUTER
  HARDWARE_HOST
}

model NetworkNode {
  id         Int       @id @default(autoincrement())
  type       NodeType
  role       NodeRole?
  label      String
  ipAddress  String?
  subnet     String?
  vendor     String?
  deviceType String?
  deviceId   Int?      @unique
  device     Device?   @relation(fields: [deviceId], references: [id])
  posX       Float?
  posY       Float?
  createdAt  DateTime  @default(now())

  edgesFrom NetworkEdge[] @relation("EdgeSource")
  edgesTo   NetworkEdge[] @relation("EdgeTarget")
}

model NetworkEdge {
  id            Int         @id @default(autoincrement())
  sourceId      Int
  source        NetworkNode @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId      Int
  target        NetworkNode @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)
  label         String?
  bandwidthMbps Float?
  // Which physical interface on each end this edge represents, when known (e.g. from an LLDP
  // neighbor entry's local/remote port). Null for manually-drawn edges, which have no real port.
  sourcePort    String?
  targetPort    String?
  // How this edge came to exist: null/omitted means manually drawn (the original behavior); real
  // values are "LLDP", "CDP", or "MAC_TABLE" — see lib/topologyEngine.ts. Kept as a plain string
  // rather than an enum since new discovery methods may be added without a migration.
  discoveredVia String?
}

enum ScanStatus {
  // Queued for a network relay agent to pick up — the VPS itself has no route into a private
  // office LAN, so when relay mode is enabled, scans wait here instead of running immediately.
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum NetworkScanTrigger {
  MANUAL
  SCHEDULED
}

model NetworkScan {
  id           Int                 @id @default(autoincrement())
  startIp      String
  endIp        String
  status       ScanStatus          @default(RUNNING)
  totalHosts   Int
  aliveHosts   Int                 @default(0)
  scannedHosts Int                 @default(0)
  triggeredBy  NetworkScanTrigger  @default(MANUAL)
  // True when this scan was (or is being) executed by an on-prem relay agent rather than
  // directly by the server process — see server/src/modules/network/relay.routes.ts.
  viaRelay     Boolean             @default(false)
  // Null for scheduled scans kicked off by the continuous network monitor rather than a person.
  startedById  Int?
  startedBy    User?               @relation(fields: [startedById], references: [id])
  startedAt    DateTime            @default(now())
  completedAt  DateTime?
  results      NetworkScanResult[]
}

model NetworkScanResult {
  id             Int         @id @default(autoincrement())
  scanId         Int
  scan           NetworkScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  ipAddress      String
  alive          Boolean
  hostname       String?
  macAddress     String?
  vendor         String?
  deviceType     String?
  // Best-effort guess from the ICMP reply's TTL (see guessOsFromTtl() in ping.ts) — a well-known
  // heuristic (~64 unmodified hops in ⇒ Linux/Unix, ~128 ⇒ Windows, ~255 ⇒ network gear/older
  // Unix), not a real fingerprint. Good enough for "what kind of thing is this" at a glance.
  os             String?
  // Cross-referenced from Device (the Python agent's own hardware self-report) by MAC/IP match —
  // never guessed for hosts the agent isn't installed on. Real remote "who's logged in" discovery
  // would need admin credentials on every target machine (WMI/RPC), which this app doesn't have.
  loggedInUser   String?
  responseTimeMs Int?
  openPorts      Int[]
  discoveredAt   DateTime    @default(now())
}

// Domotz-style continuous monitoring: a single settings row (id is always 1) drives a background
// scheduler (server/src/lib/networkMonitor.ts) that periodically re-scans the configured ranges,
// tracks each device's online/offline status over time, and can optionally poll SNMP-enabled
// devices for basic interface stats. Separate from the on-demand IP Range Scanner, which stays
// purely manual/click-to-run.
model NetworkMonitorSettings {
  id              Int       @id @default(1)
  enabled         Boolean   @default(false)
  intervalMinutes Int       @default(15)
  // Array of { startIp: string, endIp: string, label?: string }.
  ranges          Json      @default("[]")
  // Array of user ids to notify in-app on a status change. Empty = nobody.
  notifyUserIds   Json      @default("[]")
  // Array of raw email addresses to notify on a status change (may not correspond to app accounts). Empty = nobody.
  notifyEmails    Json      @default("[]")
  lastRunAt       DateTime?
  updatedById     Int?
  updatedBy       User?     @relation(fields: [updatedById], references: [id])
  updatedAt       DateTime  @updatedAt
}

enum DeviceLiveStatus {
  ONLINE
  OFFLINE
}

// Current state of every host the monitor has ever seen alive, keyed by MAC address when known
// (stable across DHCP IP changes) or by IP address when not. Distinct from Device (agent-reported
// hardware inventory) and NetworkScanResult (one row per host per scan) — this is the "latest
// known status" table the Monitoring tab reads from.
model MonitoredNetworkDevice {
  id                Int              @id @default(autoincrement())
  key               String           @unique
  ipAddress         String
  macAddress        String?
  hostname          String?
  vendor            String?
  deviceType        String?
  // Best-effort TTL-based guess, same as NetworkScanResult.os above.
  os                String?
  // Cross-referenced from Device by MAC/IP match, same as NetworkScanResult.loggedInUser above.
  loggedInUser      String?
  status            DeviceLiveStatus @default(ONLINE)
  firstSeenAt       DateTime         @default(now())
  lastSeenAt        DateTime         @default(now())
  lastChangedAt     DateTime         @default(now())
  snmpEnabled       Boolean          @default(false)
  // AES-256-GCM encrypted at rest via server/src/lib/crypto.ts encryptSecret(), same as NVR
  // credentials — never stored or returned in plaintext.
  snmpCommunity     String?
  snmpPort          Int              @default(161)
  snmpSysDescr      String?
  snmpSysName       String?
  snmpUpTimeTicks   BigInt?
  // Array of { index, name, adminStatus, operStatus, speedMbps, inOctets, outOctets }.
  snmpInterfaces    Json?
  // Array of { mac, port } — bridge/forwarding-table entries (dot1dTpFdbTable), i.e. which MAC
  // addresses this switch has actually seen on which of its own ports. Populated by the network
  // relay agent's SNMP walk (agent/kynren_network_relay.py); the direct (non-relay) SNMP poll in
  // lib/snmp.ts stays MIB-II-only (sysDescr/uptime/ifTable) and does not populate this.
  snmpMacTable      Json?
  // Array of { localPort, remoteChassisId, remotePortId, remoteSysName, protocol } — LLDP-MIB
  // (and best-effort Cisco CDP) neighbor table. `protocol` is "LLDP" or "CDP". Consumed by
  // lib/topologyEngine.ts to resolve neighbors into NetworkNode/NetworkEdge rows.
  snmpLldpNeighbors Json?
  // Array of { vlanId, name } — best-effort (dot1qVlanStaticName, falls back to Cisco vmVlan);
  // not every switch exposes this, so an empty array here just means "not read", not "no VLANs".
  snmpVlans         Json?
  // Array of { port, status } — PoE delivery state per port (pethPsePortTable), where status is
  // one of "delivering" | "searching" | "disabled" | "fault" | "unknown".
  snmpPoeStatus     Json?
  snmpLastPolledAt  DateTime?
  snmpLastError     String?

  statusEvents NetworkDeviceStatusEvent[]
}

// Subnets the on-prem network relay agent discovered on its own local routing table (e.g.
// `route print` on Windows) — surfaced to admins as a convenience so they can pick real, actually
// -present ranges for NetworkMonitorSettings.ranges instead of guessing/typing them blind. Purely
// informational: nothing here ever auto-triggers a scan on its own, since a subnet being
// technically routable doesn't mean an admin wants it monitored.
model RelayDiscoveredSubnet {
  id         Int      @id @default(autoincrement())
  cidr       String   @unique
  label      String?
  lastSeenAt DateTime @default(now())
}

enum RelayDeviceJobKind {
  PING
  HTTP
  // Raw TCP-reachability probe against host:port, with an optional RTSP OPTIONS handshake when
  // protocolScheme is "RTSP" — the relay-executed counterpart to lib/deviceConnection.ts's direct
  // net.Socket test, used by the NVR/Camera "Test Connection" button when the on-prem relay agent
  // is the only thing with a real route to the device's LAN.
  TCP_PROBE
}

enum RelayDeviceJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// A single on-demand relay-executed network call (ICMP ping, or one HTTP request against a
// device — ISAPI digest-auth call, Shelly/Tasmota/generic lighting control) — the generic,
// request/response counterpart to NetworkScan's relay job above. Short-lived: created, claimed
// within ~3s by the relay agent's poll loop (see relay.routes.ts's GET /next-device-job), and
// deleted by the awaiting caller (server/src/lib/relayDeviceJobs.ts) once it reads a terminal
// status — rows are not meant to accumulate. digestPasswordEncrypted mirrors
// Nvr.encryptedPassword's at-rest encryption (see lib/crypto.ts's encryptSecret/decryptSecret) —
// decrypted only when building the /next-device-job response the agent consumes over HTTPS.
// For PING jobs, responseBodyBase64 carries base64(JSON.stringify({alive, responseTimeMs})) —
// reusing the one generic result field rather than adding ping-specific columns.
model RelayDeviceJob {
  id                      Int                   @id @default(autoincrement())
  kind                    RelayDeviceJobKind
  status                  RelayDeviceJobStatus  @default(PENDING)
  target                  String                // PING: host/IP. HTTP: host:port
  method                  String?
  path                    String?
  protocolScheme          String?               @default("http")
  requestHeaders          Json?
  requestBody             String?
  digestUsername          String?
  digestPasswordEncrypted String?
  timeoutMs               Int                   @default(8000)
  // Lower claims first (see GET /next-device-job's orderBy). 0 = on-demand (a user waiting on a
  // response — NVR/camera check, lighting refresh, ICMP pinger, single asset ping). 10 = background
  // (the asset-heartbeat sweep's own bulk concurrent pings) so it can never starve an on-demand
  // job of a worker — see assetHeartbeat.ts's BACKGROUND_JOB_PRIORITY.
  priority                Int                   @default(0)
  responseStatus          Int?
  responseHeaders         Json?
  responseBodyBase64      String?
  errorMessage            String?
  createdAt               DateTime              @default(now())
  completedAt             DateTime?

  @@index([status, priority, createdAt])
}

enum RelayVideoJobKind {
  LIVE
  RECORDING
}

enum RelayVideoJobStatus {
  PENDING
  RUNNING
  STOPPING
  STOPPED
  FAILED
}

// Long-running counterpart to RelayDeviceJob (PING/HTTP are one-shot request/response; a video
// job runs for minutes-to-hours). id is the SAME id used as the streamRelay.ts session id / the
// recording's own id, so no separate mapping table is needed to connect a job back to where its
// uploaded segments/file should land on disk.
model RelayVideoJob {
  id           String              @id
  kind         RelayVideoJobKind
  streamUrl    String
  status       RelayVideoJobStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status])
}

model NetworkDeviceStatusEvent {
  id         Int                    @id @default(autoincrement())
  deviceId   Int
  device     MonitoredNetworkDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  status     DeviceLiveStatus
  occurredAt DateTime               @default(now())

  @@index([deviceId, occurredAt])
}

// ───────────────────────── Stock ─────────────────────────

enum StockTxType {
  IN
  OUT
  TRANSFER
}

model StockItem {
  id                 Int                 @id @default(autoincrement())
  sku                String              @unique
  name               String
  category           String?
  unit               String              @default("pcs")
  quantityOnHand     Int                 @default(0)
  reorderLevel       Int                 @default(0)
  unitCost           Decimal?            @db.Decimal(12, 2)
  locationId         Int?
  location           Location?           @relation(fields: [locationId], references: [id])
  stockLevels        StockLevel[]
  transactions       StockTransaction[]
  purchaseOrderItems PurchaseOrderItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

// Per-location quantity breakdown for a StockItem. StockItem.quantityOnHand
// remains the synced total across all locations for backward-compatible
// consumers (dashboard, low-stock, reports); this table is the source of
// truth for "how much is at location X".
model StockLevel {
  id             Int       @id @default(autoincrement())
  stockItemId    Int
  stockItem      StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  locationId     Int
  location       Location  @relation(fields: [locationId], references: [id])
  quantityOnHand Int       @default(0)
  reorderLevel   Int       @default(0)
  updatedAt      DateTime  @updatedAt

  @@unique([stockItemId, locationId])
}

model StockTransaction {
  id             Int         @id @default(autoincrement())
  stockItemId    Int
  stockItem      StockItem   @relation(fields: [stockItemId], references: [id])
  type           StockTxType
  quantity       Int
  reason         String?
  fromLocationId Int?
  toLocationId   Int?
  performedById  Int
  performedBy    User        @relation(fields: [performedById], references: [id])
  createdAt      DateTime    @default(now())
}

model Supplier {
  id             Int             @id @default(autoincrement())
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  notes          String?
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          Int                 @id @default(autoincrement())
  poNumber    String              @unique
  supplierId  Int
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  status      PurchaseOrderStatus @default(DRAFT)
  orderedAt   DateTime?
  expectedAt  DateTime?
  notes       String?
  createdById Int
  createdBy   User                @relation(fields: [createdById], references: [id])
  items       PurchaseOrderItem[]
  createdAt   DateTime            @default(now())
}

model PurchaseOrderItem {
  id               Int           @id @default(autoincrement())
  purchaseOrderId  Int
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  stockItemId      Int
  stockItem        StockItem     @relation(fields: [stockItemId], references: [id])
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCost         Decimal?      @db.Decimal(12, 2)
}

// ───────────────────────── Helpdesk ─────────────────────────

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketType {
  ACTION
  INFORMATION
}

// The ITIL object type a ticket represents — reuses the entire ticket infrastructure (tasks,
// solutions, comments, assignees, approvals) for all four instead of GLPI's approach of
// triplicating Ticket/Problem/Change into separate classes. PROBLEM/CHANGE tickets relate to the
// INCIDENT/REQUEST tickets they aggregate or resolve via TicketLink rather than a bespoke schema.
enum TicketItilType {
  INCIDENT
  REQUEST
  PROBLEM
  CHANGE
}

enum PlanningState {
  TODO
  DONE
}

enum SolutionStatus {
  WAITING
  ACCEPTED
  REFUSED
}

enum ApprovalStatus {
  WAITING
  ACCEPTED
  REFUSED
}

enum TicketLinkType {
  RELATES_TO
  CAUSES
  CAUSED_BY
  DUPLICATES
}

enum TemplateFieldMode {
  HIDDEN
  MANDATORY
  READONLY
  PREDEFINED
}

// Global config for the satisfaction-survey sampling/delay/throttle cron and the solution
// autoclose delay — the singleton-row pattern already used by EmailIngestSettings.
model HelpdeskSettings {
  id                      Int      @id @default(1)
  surveySampleRatePercent Int      @default(100)
  surveyDelayDays         Int      @default(1)
  surveyExpireDays        Int      @default(30)
  autoCloseDelayDays      Int      @default(4)
  updatedAt               DateTime @updatedAt
}

model TicketCategory {
  id                 Int                   @id @default(autoincrement())
  name               String                @unique
  parentId           Int?
  parent             TicketCategory?       @relation("TicketCategoryTree", fields: [parentId], references: [id])
  children           TicketCategory[]      @relation("TicketCategoryTree")
  defaultTemplateId  Int?
  defaultTemplate    TicketTemplate?       @relation("CategoryDefaultTemplate", fields: [defaultTemplateId], references: [id])
  defaultSlaId       Int?
  defaultSla         TicketSla?            @relation(fields: [defaultSlaId], references: [id])
  tickets            Ticket[]
  emailIngestDefault EmailIngestSettings[]
}

model Team {
  id                Int                  @id @default(autoincrement())
  name              String               @unique
  members           TeamMember[]
  ticketAssignments TicketAssignedTeam[]
  ticketApprovals   TicketApproval[]
  dashboardShares   DashboardShare[]
  savedViewShares   SavedViewShare[]
  reportShares      ReportShare[]
  recordAccessGrants RecordAccessGrant[]
  createdAt         DateTime             @default(now())
}

model TeamMember {
  id     Int  @id @default(autoincrement())
  teamId Int
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
}

model EmailIngestSettings {
  id                    Int             @id @default(1)
  isEnabled             Boolean         @default(false)
  imapHost              String?
  imapPort              Int?            @default(993)
  imapUser              String?
  imapPasswordEncrypted String?
  mailbox               String          @default("INBOX")
  fallbackRequesterId   Int?
  fallbackRequester     User?           @relation(fields: [fallbackRequesterId], references: [id])
  defaultCategoryId     Int?
  defaultCategory       TicketCategory? @relation(fields: [defaultCategoryId], references: [id])
  lastUid               Int?
  lastPolledAt          DateTime?
  lastError             String?
  updatedAt             DateTime        @updatedAt
}

model Ticket {
  id                  Int                @id @default(autoincrement())
  ticketNumber        String             @unique
  title               String
  description         String
  type                TicketType         @default(ACTION)
  itilType            TicketItilType     @default(INCIDENT)
  status              TicketStatus       @default(OPEN)
  priority            TicketPriority     @default(MEDIUM)
  categoryId          Int?
  category            TicketCategory?    @relation(fields: [categoryId], references: [id])
  templateId          Int?
  template            TicketTemplate?    @relation(fields: [templateId], references: [id])
  assetId             Int?
  asset               Asset?             @relation(fields: [assetId], references: [id])
  locationId          Int?
  location            Location?          @relation(fields: [locationId], references: [id])
  requesterId         Int
  requester           User               @relation("TicketRequester", fields: [requesterId], references: [id])
  assignees           TicketAssignee[]
  assignedTeams       TicketAssignedTeam[]
  dueAt               DateTime?
  // SLA — a simplified, calendar-time (not business-hours-aware) version of GLPI's TTO/TTR split.
  slaId               Int?
  sla                 TicketSla?         @relation(fields: [slaId], references: [id])
  ttoDueAt            DateTime?
  ttrDueAt            DateTime?
  ttoMetAt            DateTime?
  ttrMetAt            DateTime?
  satisfactionRating  Int?
  satisfactionComment String?
  satisfactionAskedAt DateTime?
  comments            TicketComment[]
  attachments         TicketAttachment[]
  watchers            TicketWatcher[]
  tasks               TicketTask[]
  solutions           TicketSolution[]
  approvals           TicketApproval[]
  knowledgeArticles   TicketKnowledgeArticle[]
  linksFrom           TicketLink[]       @relation("TicketLinkFrom")
  linksTo             TicketLink[]       @relation("TicketLinkTo")
  recurrenceSpawns    TicketRecurrence[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  resolvedAt          DateTime?
}

model TicketComment {
  id          Int                @id @default(autoincrement())
  ticketId    Int
  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    Int
  author      User               @relation(fields: [authorId], references: [id])
  body        String
  isInternal  Boolean            @default(false)
  attachments TicketAttachment[]
  createdAt   DateTime           @default(now())
}

model TicketAttachment {
  id           Int            @id @default(autoincrement())
  ticketId     Int
  ticket       Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId    Int?
  comment      TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  filename     String
  storedPath   String
  sizeBytes    Int
  uploadedById Int
  uploadedBy   User           @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime       @default(now())
}

model TicketWatcher {
  id       Int    @id @default(autoincrement())
  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   Int
  user     User   @relation(fields: [userId], references: [id])

  @@unique([ticketId, userId])
}

model TicketAssignee {
  id       Int    @id @default(autoincrement())
  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   Int
  user     User   @relation(fields: [userId], references: [id])

  @@unique([ticketId, userId])
}

model TicketAssignedTeam {
  id       Int    @id @default(autoincrement())
  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  teamId   Int
  team     Team   @relation(fields: [teamId], references: [id])

  @@unique([ticketId, teamId])
}

// A technician's time-tracked unit of work on a ticket — separate from TicketComment, which is
// just a timeline note. `actionTimeSeconds` feeds cost/effort reporting; `begin`/`end` are what a
// future Planning/calendar view would read.
model TicketTask {
  id                Int           @id @default(autoincrement())
  ticketId          Int
  ticket            Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  content           String
  category          String?
  actionTimeSeconds Int           @default(0)
  begin             DateTime?
  end               DateTime?
  state             PlanningState @default(TODO)
  assignedToId      Int?
  assignedTo        User?         @relation("TicketTaskAssignee", fields: [assignedToId], references: [id])
  authorId          Int
  author            User          @relation("TicketTaskAuthor", fields: [authorId], references: [id])
  isPrivate         Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

// A proposed fix for the ticket, distinct from a plain comment — carries its own accept/refuse
// workflow (see tickets.controller.ts's solution handlers). Multiple rows can exist per ticket if
// an earlier solution gets refused and a new one is proposed.
model TicketSolution {
  id            Int            @id @default(autoincrement())
  ticketId      Int
  ticket        Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  content       String
  authorId      Int
  author        User           @relation("TicketSolutionAuthor", fields: [authorId], references: [id])
  status        SolutionStatus @default(WAITING)
  answeredById  Int?
  answeredBy    User?          @relation("TicketSolutionAnswerer", fields: [answeredById], references: [id])
  answerComment String?
  answeredAt    DateTime?
  createdAt     DateTime       @default(now())
}

// A reusable ticket "shape" — predefined/hidden/mandatory/readonly per-field control, mirroring
// GLPI's flat (not rule-based) template model. `fields` holds one row per controlled fieldKey.
model TicketTemplate {
  id          Int                   @id @default(autoincrement())
  name        String                @unique
  itilType    TicketItilType        @default(INCIDENT)
  isDefault   Boolean               @default(false)
  fields      TicketTemplateField[]
  categories  TicketCategory[]      @relation("CategoryDefaultTemplate")
  recurrences TicketRecurrence[]
  tickets     Ticket[]
  createdAt   DateTime              @default(now())
}

// fieldKey is a client-known identifier (e.g. "title", "priority", "categoryId", "assetId",
// "locationId", "description") — not FK-validated here, same convention as
// assetTableColumns.ts's field-key registry on the client.
model TicketTemplateField {
  id              Int               @id @default(autoincrement())
  templateId      Int
  template        TicketTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fieldKey        String
  mode            TemplateFieldMode
  predefinedValue String?

  @@unique([templateId, fieldKey, mode])
}

// Simplified SLA/OLA: a flat TTO (time-to-own/first-response)/TTR (time-to-resolve) minute pair
// computed as a plain offset from ticket creation — not GLPI's working-hours-calendar-aware due
// date math, a deliberate scope cut (see the GLPI-parity research summary).
model TicketSla {
  id         Int              @id @default(autoincrement())
  name       String           @unique
  ttoMinutes Int?
  ttrMinutes Int
  categories TicketCategory[]
  tickets    Ticket[]
  createdAt  DateTime         @default(now())
}

// Stamps out a new Ticket from `template` every `periodicityDays`, `createBeforeDays` ahead of
// the actual due occurrence — a day-granularity simplification of GLPI's calendar-aware
// recurrence engine.
model TicketRecurrence {
  id                  Int            @id @default(autoincrement())
  name                String
  templateId          Int
  template            TicketTemplate @relation(fields: [templateId], references: [id])
  // Auto-created tickets need a requester — set once from whoever creates the recurrence rule
  // (server-assigned, not client-editable), not a per-run choice.
  requesterId         Int
  requester           User           @relation("TicketRecurrenceRequester", fields: [requesterId], references: [id])
  periodicityDays     Int
  createBeforeDays    Int            @default(0)
  nextCreationAt      DateTime
  endDate             DateTime?
  isActive            Boolean        @default(true)
  lastCreatedTicketId Int?
  lastCreatedTicket   Ticket?        @relation(fields: [lastCreatedTicketId], references: [id])
  createdAt           DateTime       @default(now())
}

// A generic condition-list -> action-list rule evaluated synchronously against every new ticket
// (see tickets.controller.ts's create handler) — a JSON-based simplification of GLPI's
// Rule/RuleCriteria/RuleAction class hierarchy. conditions: [{field,operator,value}], actions:
// [{field,value}].
model TicketRule {
  id         Int      @id @default(autoincrement())
  name       String
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  conditions Json
  actions    Json
  createdAt  DateTime @default(now())
}

// Relates two tickets — e.g. a PROBLEM aggregating several INCIDENTs, or a CHANGE resolving a
// PROBLEM. Directional (ticketId -> linkedTicketId) with a typed relationship.
model TicketLink {
  id             Int            @id @default(autoincrement())
  ticketId       Int
  ticket         Ticket         @relation("TicketLinkFrom", fields: [ticketId], references: [id], onDelete: Cascade)
  linkedTicketId Int
  linkedTicket   Ticket         @relation("TicketLinkTo", fields: [linkedTicketId], references: [id], onDelete: Cascade)
  linkType       TicketLinkType @default(RELATES_TO)
  createdAt      DateTime       @default(now())

  @@unique([ticketId, linkedTicketId])
}

// A request for a user or a team to accept/refuse a ticket — addressed to exactly one of
// targetUser/targetTeam. Aggregate approval status is derived (any WAITING/REFUSED blocks) rather
// than GLPI 11's multi-step ValidationStep sequencing, a deliberate scope cut.
model TicketApproval {
  id            Int            @id @default(autoincrement())
  ticketId      Int
  ticket        Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  requestedById Int
  requestedBy   User           @relation("TicketApprovalRequester", fields: [requestedById], references: [id])
  targetUserId  Int?
  targetUser    User?          @relation("TicketApprovalTargetUser", fields: [targetUserId], references: [id])
  targetTeamId  Int?
  targetTeam    Team?          @relation(fields: [targetTeamId], references: [id])
  status        ApprovalStatus @default(WAITING)
  comment       String?
  answeredById  Int?
  answeredBy    User?          @relation("TicketApprovalAnswerer", fields: [answeredById], references: [id])
  answerComment String?
  answeredAt    DateTime?
  createdAt     DateTime       @default(now())
}

// Lets a user delegate their pending ticket approvals to a substitute for a date range (e.g. while
// on leave), mirroring GLPI's "Authorized Substitutes" preference-page concept. Approval-listing
// and answer-approval logic treats the substitute as standing in for the delegator whenever
// today's date falls within [startDate, endDate] — see tickets.controller.ts listMyApprovals /
// answerApproval.
model TicketApprovalSubstitute {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation("ApprovalSubstituteDelegator", fields: [userId], references: [id], onDelete: Cascade)
  substituteId Int
  substitute   User     @relation("ApprovalSubstituteDelegate", fields: [substituteId], references: [id], onDelete: Cascade)
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime @default(now())
}

// Attaches an existing Knowledge Base article to a ticket (suggested reading / documented fix) —
// a simple many-to-many, unlike GLPI's fully generic polymorphic itemtype/items_id join.
model TicketKnowledgeArticle {
  id        Int              @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  articleId Int
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([ticketId, articleId])
}

// ───────────────────────── NVR / Cameras ─────────────────────────

enum CameraStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

model Nvr {
  id                Int           @id @default(autoincrement())
  name              String
  ipAddress         String?
  port              Int?
  // Separate from `port` (the RTSP port, typically 554) because ISAPI/ONVIF speak HTTP/SOAP on
  // their own port (typically 80/443) — reusing one field for both was the root cause of ISAPI
  // calls landing on the RTSP daemon and getting back a raw "RTSP/1.0 400 Bad Request" instead of
  // a JSON device-info response. Null defaults to 80 in the ISAPI/ONVIF client code.
  httpPort          Int?
  protocol          String?       @default("RTSP")
  username          String?
  encryptedPassword String?
  locationId        Int?
  location          Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  model             String?
  notes             String?
  status            CameraStatus  @default(UNKNOWN)
  lastCheckedAt     DateTime?
  cameras           Camera[]
  events            CameraEvent[]
  createdAt         DateTime      @default(now())
}

model Camera {
  id                Int               @id @default(autoincrement())
  nvrId             Int
  nvr               Nvr               @relation(fields: [nvrId], references: [id], onDelete: Cascade)
  name              String
  channel           Int?
  locationId        Int?
  location          Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  ipAddress         String?
  port              Int?
  // See Nvr.httpPort's comment — same RTSP-vs-ISAPI/ONVIF port split, needed here too since a
  // camera can be addressed directly (not just through its parent NVR).
  httpPort          Int?
  username          String?
  encryptedPassword String?
  streamUrl         String?
  ptzEnabled        Boolean           @default(false)
  status            CameraStatus      @default(UNKNOWN)
  lastCheckedAt     DateTime?
  events            CameraEvent[]
  recordings        CameraRecording[]
  // Implicit many-to-many — a camera covering an entrance can reasonably be linked to more than
  // one door (e.g. a lobby camera facing two adjacent doors), and a door can have more than one
  // linked camera (inside + outside view).
  doors             Door[]
}

model CameraRecording {
  id        Int       @id @default(autoincrement())
  cameraId  Int
  camera    Camera    @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  filePath  String
  startedAt DateTime
  endedAt   DateTime?
  sizeBytes Int?
  trigger   String
  createdAt DateTime  @default(now())
}

model CameraEvent {
  id        Int      @id @default(autoincrement())
  nvrId     Int?
  nvr       Nvr?     @relation(fields: [nvrId], references: [id], onDelete: Cascade)
  cameraId  Int?
  camera    Camera?  @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  type      String
  message   String?
  createdAt DateTime @default(now())
}

// ───────────────────────── Access Control (Hikvision ISAPI) ─────────────────────────
// A door controller talked to over the same Hikvision ISAPI family already used for camera
// discovery (server/src/lib/hikvisionIsapi.ts), just a different endpoint set
// (/ISAPI/AccessControl/*) — see that file for exactly which calls are real vs. best-effort
// pending verification against physical hardware.

enum DoorLockState {
  LOCKED
  UNLOCKED
  UNKNOWN
}

// The physical door-contact position (is the door itself sitting open or closed) — distinct
// from DoorLockState (is the electric lock/strike engaged). A door can be CLOSED but UNLOCKED
// (someone could push it open any moment), or OPEN while LOCKED was the last command sent.
enum DoorState {
  OPEN
  CLOSED
  UNKNOWN
}

enum AccessCredentialStatus {
  ACTIVE
  DISABLED
}

// A registered Paxton Net2 access-control server. Net2's real door/credential control requires
// the customer's own Net2 API licence (ClientID + OAuth2 credentials issued by their Net2
// install) which this app cannot obtain on its own — so today this only tracks connection
// details and reachability, mirroring how NVR/AccessControlDevice track a device before deeper
// protocol support exists. See Gates.routes.ts for the discovery/test-connection logic.
model Net2Server {
  id                Int          @id @default(autoincrement())
  name              String
  ipAddress         String
  port              Int          @default(8443)
  clientId          String?
  username          String?
  encryptedPassword String?
  notes             String?
  status            CameraStatus @default(UNKNOWN)
  lastCheckedAt     DateTime?
  createdById       Int
  createdBy         User         @relation(fields: [createdById], references: [id])
  createdAt         DateTime     @default(now())
}

model AccessControlDevice {
  id                Int                @id @default(autoincrement())
  name              String
  ipAddress         String?
  port              Int?
  username          String?
  encryptedPassword String?
  locationId        Int?
  location          Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  model             String?
  notes             String?
  status            CameraStatus       @default(UNKNOWN)
  lastCheckedAt     DateTime?
  lastEventSyncAt   DateTime?
  doors             Door[]
  credentials       AccessCredential[]
  events            AccessEvent[]
  createdAt         DateTime           @default(now())
}

model Door {
  id               Int                         @id @default(autoincrement())
  deviceId         Int
  device           AccessControlDevice         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  doorNumber       Int
  name             String
  lockState        DoorLockState               @default(UNKNOWN)
  doorState        DoorState                   @default(UNKNOWN)
  lastCheckedAt    DateTime?
  events           AccessEvent[]
  credentialRights AccessCredentialDoorRight[]
  groupDoors       AccessGroupDoor[]
  // Cameras an operator wants to see pop up when this door opens — see the "Read Card"/status
  // routes in accessControl.routes.ts for how these get surfaced.
  cameras          Camera[]

  @@unique([deviceId, doorNumber])
}

// One credential (card and/or PIN) enrolled on one physical controller for one app User.
// Hikvision access control is per-device (there's no central directory unless a separate VMS
// like HikCentral sits in front of it, which is out of scope here) — the same person needing
// access on two controllers gets two AccessCredential rows, each with its own device-assigned
// employeeNo.
model AccessCredential {
  id         Int                         @id @default(autoincrement())
  deviceId   Int
  device     AccessControlDevice         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  personId   Int
  person     Person                      @relation(fields: [personId], references: [id], onDelete: Cascade)
  employeeNo String
  cardNumber String?
  hasPin     Boolean                     @default(false)
  status     AccessCredentialStatus      @default(ACTIVE)
  validFrom  DateTime?
  validTo    DateTime?
  doorRights AccessCredentialDoorRight[]
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  @@unique([deviceId, employeeNo])
}

// Mirrors Hikvision's own UserInfo.RightPlan array (one {doorNo, planTemplateNo} entry per
// door a person may use) — planTemplateNo references a schedule template already configured
// on the controller itself (e.g. "1" = All-day, "2" = Weekday, per that device's own admin UI);
// this app doesn't author templates, only assigns a template number per door. An
// AccessCredential with no rows here was provisioned without a RightPlan at all, which leaves
// the controller's own default access behavior in effect for that person.
model AccessCredentialDoorRight {
  id             Int              @id @default(autoincrement())
  credentialId   Int
  credential     AccessCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  doorId         Int
  door           Door             @relation(fields: [doorId], references: [id], onDelete: Cascade)
  planTemplateNo String           @default("1")

  @@unique([credentialId, doorId])
}

// ───────────────────────── Person / Organization directory (Access Control) ─────────────────────────
// A physical building occupant (staff, contractor, visitor) enrolled for door access — distinct
// from the app's own User accounts (login/RBAC), since most access-control persons never log
// into this app at all. Mirrors Hikvision's own Person/Organization directory: a self-referencing
// department tree, and a Person with a controller-facing personId (not this table's own `id`),
// credential cards, and a validity window.

model Organization {
  id        Int            @id @default(autoincrement())
  name      String
  parentId  Int?
  parent    Organization?  @relation("OrgTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Organization[] @relation("OrgTree")
  persons   Person[]
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
}

enum PersonGender {
  MALE
  FEMALE
}

model Person {
  id                Int                 @id @default(autoincrement())
  personId          String              @unique
  name              String
  gender            PersonGender        @default(MALE)
  email             String?
  phone             String?
  organizationId    Int?
  organization      Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  validFrom         DateTime?
  validTo           DateTime?
  longTermEffective Boolean             @default(false)
  remark            String?
  photoUrl          String?
  cards             PersonCard[]
  credentials       AccessCredential[]
  groupMemberships  AccessGroupMember[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model PersonCard {
  id         Int      @id @default(autoincrement())
  personId   Int
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  cardNumber String   @unique
  cardType   String   @default("Normal Card")
  createdAt  DateTime @default(now())
}

// ───────────────────────── Access Group (Access Control) ─────────────────────────
// A named bundle of {persons + doors + schedule template} — matches Hikvision's own "Access
// Group" screen: every person in the group is granted access to every door in the group, on the
// assigned schedule template, in one "Apply to Device" push instead of provisioning each
// person/door pair individually via Credentials.

model AccessGroup {
  id             Int                 @id @default(autoincrement())
  name           String
  planTemplateNo String              @default("1")
  lastAppliedAt  DateTime?
  members        AccessGroupMember[]
  doors          AccessGroupDoor[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model AccessGroupMember {
  id       Int         @id @default(autoincrement())
  groupId  Int
  group    AccessGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  personId Int
  person   Person      @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([groupId, personId])
}

model AccessGroupDoor {
  id      Int         @id @default(autoincrement())
  groupId Int
  group   AccessGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  doorId  Int
  door    Door        @relation(fields: [doorId], references: [id], onDelete: Cascade)

  @@unique([groupId, doorId])
}

// ───────────────────────── Lighting (local, web-controllable IoT devices) ─────────────────────────

enum LightingDeviceKind {
  SWITCH
  LIGHT
}

// Which local driver controls this device (see server/src/lib/iotDeviceApi.ts, the dispatcher
// every route goes through instead of calling a protocol-specific client directly):
//   SHELLY       - Shelly's Gen1 REST / Gen2+3 JSON-RPC local API (server/src/lib/shellyApi.ts)
//   TASMOTA      - Tasmota firmware's HTTP `/cm?cmnd=` API (server/src/lib/tasmotaApi.ts),
//                  the other dominant open-source local-network IoT relay/light firmware
//   GENERIC_HTTP - a universal escape hatch: the user supplies their own On/Off (and optional
//                  status) URLs, so anything with *any* documented HTTP control endpoint can be
//                  added without a dedicated driver — Home Assistant automations, IFTTT/webhook
//                  proxies, ESPHome's REST API, self-rolled relays, etc. Cloud-account-only
//                  ecosystems (Hue, LIFX, Govee, Tuya) aren't wired up as first-class drivers —
//                  they need OAuth/cloud API keys, a different integration shape entirely from
//                  every other "local network, no cloud" device this app already manages — but
//                  a device's own local bridge/automation webhook can still be added as GENERIC_HTTP.
enum LightingProtocol {
  SHELLY
  TASMOTA
  GENERIC_HTTP
  ZIGBEE
}

// One physical device (switch or dimmable light) controlled directly over the local network —
// no cloud account required for any of the three drivers above. `gen`/`kind` are Shelly/Tasmota
// concepts (null until first successful contact auto-detects them); `onUrl`/`offUrl`/`statusUrl`/
// `statusOnPath` are GENERIC_HTTP-only, user-supplied at add time (see lighting.schema.ts).
model LightingDevice {
  id                   Int                        @id @default(autoincrement())
  name                 String
  protocol             LightingProtocol           @default(SHELLY)
  ipAddress            String?
  port                 Int?
  gen                  Int?
  kind                 LightingDeviceKind?
  channel              Int                        @default(0)
  onUrl                String?
  offUrl               String?
  statusUrl            String?
  statusOnPath         String?
  // ZIGBEE-protocol devices only — set once paired via the coordinator (see ZigbeeCoordinator).
  zigbeeIeeeAddress    String?
  zigbeeNetworkAddress Int?
  icon                 String?
  sortOrder            Int                        @default(0)
  groupId              Int?
  group                LightingGroup?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
  locationId           Int?
  location             Location?                  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  status               CameraStatus               @default(UNKNOWN)
  isOn                 Boolean                    @default(false)
  brightness           Int?
  powerW               Float?
  lastCheckedAt        DateTime?
  createdAt            DateTime                   @default(now())
  sceneActions         LightingSceneAction[]
  automationActions    LightingAutomationAction[]
  siteMapPlacements    LightingSiteMapDevice[]
}

// A user-defined grouping of lighting devices, shown as a card on the Lighting Dashboard —
// either a physical "Area" (Kitchen, Garage) or any custom name. Purely organizational: has no
// effect on how a device is controlled, only how it's presented and dragged around.
model LightingGroup {
  id        Int              @id @default(autoincrement())
  name      String
  icon      String?
  sortOrder Int              @default(0)
  devices   LightingDevice[]
  createdAt DateTime         @default(now())
}

// A saved snapshot of desired on/off (and brightness, where supported) states across a set of
// devices, applied all at once via "Activate" — e.g. "Movie Night" dims the lounge and switches
// off the hallway in one click.
model LightingScene {
  id          Int                   @id @default(autoincrement())
  name        String
  icon        String?
  actions     LightingSceneAction[]
  automations LightingAutomation[]
  createdAt   DateTime              @default(now())
}

model LightingSceneAction {
  id         Int            @id @default(autoincrement())
  sceneId    Int
  scene      LightingScene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  deviceId   Int
  device     LightingDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  turnOn     Boolean
  brightness Int?

  @@unique([sceneId, deviceId])
}

enum LightingAutomationActionType {
  DEVICE
  SCENE
}

// A recurring schedule ("Mon-Fri at 18:00, turn on Porch Light") — the calendar view on the
// Automations tab projects daysOfWeek/timeOfDay onto a month grid rather than storing one-off
// calendar events, since every automation here repeats weekly by design.
model LightingAutomation {
  id             Int                          @id @default(autoincrement())
  name           String
  isEnabled      Boolean                      @default(true)
  daysOfWeek     Int[]
  timeOfDay      String
  actionType     LightingAutomationActionType
  // DEVICE actions target one or more devices at once (same shape as LightingSceneAction) —
  // matches how Scenes already let one activation touch a whole set of devices.
  actions        LightingAutomationAction[]
  targetSceneId  Int?
  targetScene    LightingScene?               @relation(fields: [targetSceneId], references: [id], onDelete: Cascade)
  // Optional paired "off" trigger for DEVICE automations — at this time, every device in
  // `actions` is turned off, so one automation can cover "on at 18:00, off at 23:00" instead of
  // needing two separate automations. Not applicable to SCENE automations (a scene has no
  // inherent inverse state), so this stays null for those.
  offTimeOfDay   String?
  // "YYYY-MM-DD" of the last date this fired — the scheduler ticks every minute but this dedup
  // key stops it from re-firing the same automation more than once on the same day.
  lastRunDate    String?
  // Separate dedup key for the offTimeOfDay trigger, since the on- and off-legs of the same
  // automation fire independently and both may legitimately run on the same day.
  lastRunDateOff String?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  runs           LightingAutomationRun[]
}

// One row per time the scheduler actually fires an automation (on- or off-leg) — gives visibility
// beyond the single lastRunDate/lastRunDateOff dedup string, which only ever remembers "the last
// date", not what happened or whether every device actually responded. automationId is nullable
// with onDelete: SetNull (and the name snapshotted separately) so this history survives deleting
// the automation itself.
model LightingAutomationRun {
  id             Int                          @id @default(autoincrement())
  automationId   Int?
  automation     LightingAutomation?          @relation(fields: [automationId], references: [id], onDelete: SetNull)
  automationName String
  trigger        LightingAutomationRunTrigger
  status         LightingAutomationRunStatus
  deviceCount    Int                          @default(0)
  failedCount    Int                          @default(0)
  message        String?
  ranAt          DateTime                     @default(now())

  @@index([ranAt])
  @@index([automationId])
}

enum LightingAutomationRunTrigger {
  ON
  OFF
}

enum LightingAutomationRunStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model LightingAutomationAction {
  id           Int                @id @default(autoincrement())
  automationId Int
  automation   LightingAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  deviceId     Int
  device       LightingDevice     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  turnOn       Boolean
  brightness   Int?

  @@unique([automationId, deviceId])
}

// ───────────────────────── ZigBee (shared scaffold: Lighting + Access Control) ─────────────────────────
// NOT hardware-verified — no ZigBee coordinator has been available in this environment. Modeled
// after the zigbee-herdsman/zigbee2mqtt shape (a coordinator dongle bridging a PAN of paired end
// devices) so a real integration can be dropped in behind these same models later. Lighting's own
// ZigBee bulbs/switches become ordinary LightingDevice rows (protocol: ZIGBEE) once paired, so
// they participate in Groups/Scenes/Automations like any other device — ZigbeeDevice below is
// only for end devices that don't fit LightingDevice, e.g. Access Control's door/window contact
// sensors and standalone ZigBee locks.
enum ZigbeeModule {
  LIGHTING
  ACCESS_CONTROL
}

enum ZigbeeCoordinatorStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

model ZigbeeCoordinator {
  id         Int                     @id @default(autoincrement())
  module     ZigbeeModule            @unique
  serialPort String?
  status     ZigbeeCoordinatorStatus @default(DISCONNECTED)
  lastError  String?
  panId      String?
  updatedAt  DateTime                @updatedAt
}

enum ZigbeeDeviceType {
  CONTACT_SENSOR
  LOCK
  MOTION_SENSOR
  OTHER
}

model ZigbeeDevice {
  id           Int              @id @default(autoincrement())
  module       ZigbeeModule
  ieeeAddress  String           @unique
  friendlyName String
  deviceType   ZigbeeDeviceType @default(OTHER)
  isOn         Boolean?
  contactOpen  Boolean?
  batteryPct   Int?
  lastSeenAt   DateTime?
  locationId   Int?
  location     Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
}

enum LightingScanStatus {
  RUNNING
  COMPLETED
  FAILED
}

// One "Discover" sweep of a /24-sized range, same async job + poll pattern as the Network
// Topology Map's IP Range Scanner (server/src/modules/network/scan.service.ts) — the scan
// starts in the background, `scannedHosts` ticks up as each address is probed, and the client
// polls GET /lighting/discover/:id until status leaves RUNNING. Unlike the network scanner,
// only actual hits (Shelly or Tasmota — see shellyProbe.ts/tasmotaProbe.ts) are persisted as
// LightingScanResult rows — a non-responsive or unrecognized host just advances the counter,
// nothing is stored for it. GENERIC_HTTP devices have no fixed identifying signal to probe for,
// so they're never auto-discovered — they're always added manually via the Add Device form.
model LightingScan {
  id           Int                  @id @default(autoincrement())
  startIp      String
  endIp        String
  status       LightingScanStatus   @default(RUNNING)
  totalHosts   Int
  scannedHosts Int                  @default(0)
  startedAt    DateTime             @default(now())
  completedAt  DateTime?
  results      LightingScanResult[]
}

model LightingScanResult {
  id           Int              @id @default(autoincrement())
  scanId       Int
  scan         LightingScan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  ipAddress    String
  protocol     LightingProtocol @default(SHELLY)
  name         String?
  model        String?
  gen          Int?
  alreadyAdded Boolean          @default(false)
  discoveredAt DateTime         @default(now())
}

// A floor-plan/site image with lighting devices pinned to specific (x,y) positions on it — a
// visual alternative to the Dashboard's card-grid view. x/y and shape geometry are stored as
// percentages of the image's own dimensions (not pixels) so a map renders correctly at any
// viewport width without persisting the image's pixel size separately.
model LightingSiteMap {
  id        Int                     @id @default(autoincrement())
  name      String
  imageUrl  String
  sortOrder Int                     @default(0)
  // 0-100 — a dark scrim drawn over the whole map, punched through with an animated "cleared"
  // hole over each ON light's own coverage shape (or a small default circle around its marker
  // when no shape has been drawn). 0 disables the overlay entirely. See SiteMapEditor.tsx.
  overlayDensity Int                @default(0)
  createdAt DateTime                @default(now())
  devices   LightingSiteMapDevice[]
}

enum LightingSiteMapShapeType {
  NONE
  CIRCLE
  POLYGON
  PATH
}

// One device's placement on one site map: position, optional coverage shape, and the
// icon/color pair shown for its on/off state (independent of the device's own `icon` field,
// which is used elsewhere e.g. the Dashboard tile). zoneOffColor is deliberately not a separate
// field — the coverage shape is simply dimmed (reduced opacity) when the device is off.
model LightingSiteMapDevice {
  id          Int                      @id @default(autoincrement())
  siteMapId   Int
