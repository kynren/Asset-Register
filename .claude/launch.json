{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "asset-register-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "server"],
      "port": 4000,
      "autoPort": false
    },
    {
      "name": "asset-register-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "client"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "asset-register-mobile",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "mobile:dev"],
      "port": 8081,
      "autoPort": true
    },
    {
      "name": "asset-register-mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "mobile:web"],
      "port": 8081,
      "autoPort": true
    }
  ]
}
